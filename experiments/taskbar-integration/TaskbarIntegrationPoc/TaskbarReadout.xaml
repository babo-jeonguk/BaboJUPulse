<UserControl x:Class="BaboJUPulse.TaskbarIntegrationPoc.TaskbarReadout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Synthetic CPU and RAM taskbar readout">
    <Border Margin="2"
            Padding="8,2"
            Background="#CC202020"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#FFB86B"
                       Text="SYNTH" />

            <TextBlock x:Name="MetricText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="13"
                       Foreground="White"
                       Text="CPU --%  RAM --%"
                       TextTrimming="CharacterEllipsis" />

            <Button x:Name="ExitButton"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Exit taskbar PoC"
                    Background="#33808080"
                    BorderBrush="Transparent"
                    Click="OnExitButtonClicked"
                    ToolTip="Exit the taskbar PoC">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="10"
                           Foreground="White"
                           Text="&#xE711;" />
            </Button>
        </Grid>
    </Border>
</UserControl>
